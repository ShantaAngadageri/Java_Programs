package Polymorphism;

interface Amazon1{
	void buy() ;
}
class Shoes1 implements Amazon1{
	public void buy() {
		System.out.println("Buy shoes");
	}
}
class Dress1 implements Amazon1{
	public void buy() {
		System.out.println("buy dress at amazon");
	}
}
class Mobiles1 implements Amazon1{
	public void buy() {
		System.out.println("buy moblies");
		}
}
class stimulators3 {
	static void purchase(Amazon1 a1) {
		a1.buy();
	}
}
public class interface2 {
	public static void main(String[] args) {
		Mobiles1 a1=new Mobiles1();
		Shoes1 s1=new Shoes1();
		Dress1 d1=new Dress1();
		stimulators3.purchase(a1);
		stimulators3.purchase(s1);
		stimulators3.purchase(d1);
	} 
}
