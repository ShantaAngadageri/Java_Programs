package Interface;


interface Mobile1{
	void feature();
}
class Vivo implements Mobile1{
	public void feature() {
		System.out.println("Vivo mobile");
	}
}
class Oppo implements Mobile1{
	public void feature() {
		System.out.println("Oppo mobile");
	}
}
class Redmi implements Mobile1{
	public void feature() {
		System.out.println("Redmi mobile");
	}
}
class stimulator{
	static void buy(Mobile1 b1) {
		b1.feature();
	}
}

public class interface3 {
	public static void main(String[] args)
	{
		Vivo v1 = new Vivo();
		Oppo o=new Oppo();
		Redmi r= new Redmi();
		stimulator.buy(v1);
		stimulator.buy(o);
		stimulator.buy(r);
	}
}
